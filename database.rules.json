{
  "rules": {
    // Par défaut, interdit la lecture et l'écriture à la racine de la base de données
    ".read": false,
    ".write": false,

    // Autorise la lecture et l'écriture uniquement sur les chemins spécifiques requis par l'application
    "classes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "results": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "student_results": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "plan_progress": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "presence": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
